# ===========================================
# SCHEDIUM FRONTEND - ENVIRONMENT VARIABLES
# ===========================================

# Application Configuration
NODE_ENV=development
VITE_APP_NAME="Schedium"
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION="Sistema de Gestión de Horarios Académicos SENA"

# API Configuration
VITE_API_BASE_URL=http://localhost:8000
VITE_API_VERSION=v1
VITE_API_TIMEOUT=30000

# Authentication
VITE_AUTH_TOKEN_KEY=schedium_token
VITE_AUTH_REFRESH_TOKEN_KEY=schedium_refresh_token
VITE_AUTH_SESSION_TIMEOUT=3600000
VITE_AUTH_REMEMBER_ME_TIMEOUT=604800000

# Application Features
VITE_ENABLE_PWA=true
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ERROR_REPORTING=true
VITE_ENABLE_PERFORMANCE_MONITORING=true
VITE_ENABLE_WEBSOCKETS=true
VITE_ENABLE_NOTIFICATIONS=true

# WebSocket Configuration
VITE_WS_URL=ws://localhost:8000/ws
VITE_WS_RECONNECT_INTERVAL=5000
VITE_WS_MAX_RECONNECT_ATTEMPTS=10

# File Upload Configuration
VITE_MAX_FILE_SIZE=10485760
VITE_ALLOWED_FILE_TYPES=.pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png,.gif
VITE_UPLOAD_ENDPOINT=/api/v1/upload

# Internationalization
VITE_DEFAULT_LOCALE=es
VITE_FALLBACK_LOCALE=en
VITE_AVAILABLE_LOCALES=es,en

# Theme Configuration
VITE_DEFAULT_THEME=light
VITE_ENABLE_DARK_MODE=true
VITE_ENABLE_THEME_PERSISTENCE=true

# External Services Configuration
VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_RELEASE=1.0.0

# Security Configuration
VITE_ENABLE_CSP=true
VITE_CSRF_TOKEN_HEADER=X-CSRF-Token
VITE_SECURITY_HEADERS=true

# Debugging & Development
VITE_DEBUG_MODE=false
VITE_LOG_LEVEL=info

# ===========================================
# PRODUCTION/DEPLOYMENT VARIABLES
# ===========================================

# Domain Configuration
FRONTEND_DOMAIN=schedium.example.com
API_DOMAIN=api.schedium.example.com

# SSL/TLS Configuration
ACME_EMAIL=admin@schedium.example.com

# Docker Configuration
DOCKER_REGISTRY=ghcr.io
DOCKER_IMAGE_NAME=schedium/frontend
DOCKER_TAG=latest

# Load Balancer Configuration
TRAEFIK_AUTH_USER=admin:$2y$10$hashed_password_here

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=schedium
DB_USER=schedium_user
DB_PASSWORD=your_secure_password_here

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# Monitoring
GRAFANA_ADMIN_PASSWORD=your_grafana_password_here