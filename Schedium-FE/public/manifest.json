    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/dashboard.png",
      "type": "image/png",
      "sizes": "1280x720",
      "form_factor": "wide"
    },
    {
      "src": "/screenshots/schedule.png",
      "type": "image/png",
      "sizes": "1280x720",
      "form_factor": "wide"
    },
    {
      "src": "/screenshots/mobile-dashboard.png",
      "type": "image/png",
      "sizes": "360x640",
      "form_factor": "narrow"
    }
  ],
  "shortcuts": [
    {
      "name": "Horarios",
      "short_name": "Horarios",
      "description": "Ver y gestionar horarios académicos",
      "url": "/scheduling/schedules",
      "icons": [{ "src": "/icons/schedule.png", "sizes": "96x96" }]
    },
    {
      "name": "Instructores",
      "short_name": "Instructores",
      "description": "Gestión de instructores",
      "url": "/hr/instructors",
      "icons": [{ "src": "/icons/instructor.png", "sizes": "96x96" }]
    },
    {
      "name": "Estudiantes",
      "short_name": "Estudiantes",
      "description": "Gestión de estudiantes",
      "url": "/academic/students",
      "icons": [{ "src": "/icons/student.png", "sizes": "96x96" }]
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "file",
          "accept": ["image/*", "application/pdf"]
        }
      ]
    }
  },
  "features": [
    "scheduling",
    "notifications",
    "offline",
    "sync"
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  }
}