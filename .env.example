# ==============================================
# SCHEDIUM - DOCKER ENVIRONMENT VARIABLES
# ==============================================

# ==============================================
# APPLICATION SETTINGS
# ==============================================
APP_ENV=development
DEBUG=false

# ==============================================
# DATABASE CONFIGURATION
# ==============================================
DB_HOST=mysql
DB_PORT=3306
DB_NAME=schedium
DB_USER=schedule
DB_PASSWORD=HorariosSena1
DB_ROOT_PASSWORD=rootpassword

# ==============================================
# REDIS CONFIGURATION
# ==============================================
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6380

# ==============================================
# BACKEND SECURITY
# ==============================================
SECRET_KEY=super-secret-key-change-in-production-please
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==============================================
# CORS CONFIGURATION
# ==============================================
BACKEND_CORS_ORIGINS=http://localhost:3000,http://frontend:80,http://localhost:8080

# ==============================================
# RATE LIMITING
# ==============================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ==============================================
# LOGGING
# ==============================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# ==============================================
# FRONTEND CONFIGURATION
# ==============================================
VITE_API_URL=http://localhost:8001
VITE_APP_NAME=Schedium
VITE_APP_ENV=development

# ==============================================
# PORTS CONFIGURATION
# ==============================================
# External ports (host machine)
DB_PORT=3307
API_PORT=8001
FRONTEND_PORT=3000
NGINX_PORT=80
NGINX_SSL_PORT=443

# ==============================================
# NGINX (PRODUCTION)
# ==============================================
# Only used with profile=production
# NGINX_PORT=80
# NGINX_SSL_PORT=443